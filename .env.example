# 复制此文件为 .env，填入真实值，.env 不进 Git

# ---------- MCP 数据接口（待确认）----------
MCP_API_KEY=your_mcp_api_key_here
MCP_BASE_URL=https://your-mcp-endpoint.com

# ---------- Tushare（付费备用）----------
TUSHARE_TOKEN=your_tushare_token_here

# ---------- QMT 交易账户 ----------
QMT_PATH=C:/QMT/userdata_mini
QMT_ACCOUNT_ID=your_account_id
QMT_ACCOUNT_TYPE=STOCK

# ---------- 企业微信机器人 ----------
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY

# ---------- 项目路径 ----------
PROJECT_ROOT=/path/to/quant
DATA_STORE_ROOT=/path/to/quant/data_store
LOG_DIR=/path/to/quant/logs

# ---------- 策略环境 ----------
ENV=development
# ENV=production
