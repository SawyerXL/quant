+def split_positions(positions: dict) -> tuple[dict, dict]:
+    """按 volume 正/负拆分；负持仓=仿真伪影，单独落盘不得静默丢弃。
+
+    2026-10-20 实锤：002028 −399 股被旧导出 `volume>0` 过滤，快照/对账全链
+    对负持仓盲（残差审计待办第 2 项）。执行层已在 `trader._scoped_positions`
+    按 0 持仓隔离，本函数只负责让观测层看得见。
+    """
+    pos, neg = {}, {}
+    for code, p in positions.items():
+        v = p.get("volume", 0) or 0
+        rec = {"volume": v,
+               "cost_price": p.get("cost_price", 0),
+               "market_value": p.get("market_value", 0)}
+        key = code.split(".")[0]
+        if v > 0:
+            pos[key] = rec
+        elif v < 0:
+            neg[key] = rec
+    return pos, neg
+
